# --- Core flags -------------------------------------------------------------
# Demo mode is ON by default (in-memory data, no DB needed). Set to "false"
# once you've provisioned a real database (see README > Swap demo data).
DEMO_MODE=true

# Turns on real Netlify Identity auth + route guards + audit logging.
# Off by default so the app runs with zero configuration.
AUTH_ENABLED=false

# --- Database (only needed when DEMO_MODE=false) -----------------------------
# Provisioned automatically by `netlify database init` — do not set by hand.
# NETLIFY_DB_URL=

# --- Auth-only local dev (only used when AUTH_ENABLED=true) -----------------
# @netlify/identity doesn't work outside a real Netlify deploy. When running
# `netlify dev` locally with auth on, set this to fake a logged-in user:
# AUTH_DEV_USER={"email":"you@example.com","roles":["admin"]}

# --- Signup role assignment (only used when AUTH_ENABLED=true) -------------
# REQUIRED once Identity signups are enabled — no default, on purpose. The
# role every new user gets in app_metadata.roles at signup time. See
# netlify/functions/identity.mts and README > Roles.
# DEFAULT_ROLE=

# --- Hard purge (soft delete is always on; this only controls permanent
# deletion of already soft-deleted records) ----------------------------------
# Off by default and genuinely inert when off — no purge job runs, ever,
# and RECORD_RETENTION_DAYS below is never read. See README > Soft delete.
# PURGE_ENABLED=false
#
# REQUIRED once PURGE_ENABLED=true — no default, on purpose. A retention
# period is a compliance decision, not a safe engineering default.
# RECORD_RETENTION_DAYS=

# --- Notifications (optional, all no-op if unset) ----------------------------
# SLACK_WEBHOOK_URL=
# RESEND_API_KEY=
# NOTIFY_EMAIL_FROM=
# NOTIFY_EMAIL_TO=
